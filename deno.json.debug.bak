{
  "tasks": {
    "start": "deno run --allow-env --allow-net --allow-read --allow-write --env-file=.env bot/main.ts",
    "dev": "deno run --watch --allow-env --allow-net --allow-read --allow-write --env-file=.env bot/main.ts",
    "login": "deno run --allow-env --allow-net --allow-read --allow-write --env-file=.env bot/linejs/login.ts"
  },
  "imports": {
    "@evex/linejs": "jsr:@evex/linejs@3.4.2"
  }
}
