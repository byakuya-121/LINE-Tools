const accessToken = Deno.env.get("LINE_CHANNEL_ACCESS_TOKEN") ?? "";

type PendingLink = {
  userId: string;
  url: string;
  nonce: string;
  expiresAt: number;
};

type LinkStatus = {
  verified: boolean;
  updatedAt: number;
};

const pendingByUser = new Map<string, PendingLink>();
const pendingByNonce = new Map<string, PendingLink>();
const statuses = new Map<string, LinkStatus>();

function randomNonce(): string {
  const bytes = crypto.getRandomValues(new Uint8Array(24));
  let binary = "";

  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

function cleanExpired(): void {
  const now = Date.now();

  for (const [nonce, pending] of pendingByNonce) {
    if (pending.expiresAt <= now) {
      pendingByNonce.delete(nonce);

      if (pendingByUser.get(pending.userId)?.nonce === nonce) {
        pendingByUser.delete(pending.userId);
      }
    }
  }
}

export async function startAccountLink(userId: string): Promise<string> {
  if (!userId) {
    throw new Error("ユーザーIDを取得できませんでした。");
  }

  if (!accessToken) {
    throw new Error("LINE_CHANNEL_ACCESS_TOKEN が未設定です。");
  }

  cleanExpired();

  const response = await fetch(
    `https://api.line.me/v2/bot/user/${encodeURIComponent(userId)}/linkToken`,
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${accessToken}`,
      },
    },
  );

  if (!response.ok) {
    console.error("[AccountLink] Token issuance failed:", response.status);
    throw new Error(
      `LINE連携トークンの発行に失敗しました（HTTP ${response.status}）。`,
    );
  }

  const data = await response.json() as { linkToken?: string };

  if (!data.linkToken) {
    throw new Error("LINEから連携トークンを取得できませんでした。");
  }

  const nonce = randomNonce();
  const expiresAt = Date.now() + 10 * 60 * 1000;

  const linkUrl = new URL(
    "https://access.line.me/dialog/bot/accountLink",
  );

  linkUrl.searchParams.set("linkToken", data.linkToken);
  linkUrl.searchParams.set("nonce", nonce);

  const pending: PendingLink = {
    userId,
    url: linkUrl.toString(),
    nonce,
    expiresAt,
  };

  const previous = pendingByUser.get(userId);

  if (previous) {
    pendingByNonce.delete(previous.nonce);
  }

  pendingByUser.set(userId, pending);
  pendingByNonce.set(nonce, pending);

  statuses.set(userId, {
    verified: false,
    updatedAt: Date.now(),
  });

  return pending.url;
}

export function getPendingLinkUrl(userId: string): string | null {
  cleanExpired();
  return pendingByUser.get(userId)?.url ?? null;
}

export function getAccountLinkStatus(userId: string): string {
  cleanExpired();

  const pending = pendingByUser.get(userId);

  if (pending) {
    return "確認待ちです。公式アカウントから届いた連携URLを開いてください。";
  }

  const status = statuses.get(userId);

  if (!status) {
    return "未確認です。先に !setup を送信してください。";
  }

  if (status.verified) {
    return `LINEアカウント連携の確認済み（${new Date(status.updatedAt).toLocaleString("ja-JP")}）`;
  }

  return "連携確認に失敗しました。もう一度 !setup を実行してください。";
}

export function completeAccountLink(
  eventUserId: string | undefined,
  nonce: string,
  result: string,
): { accepted: boolean; userId?: string; message: string } {
  cleanExpired();

  const pending = pendingByNonce.get(nonce);

  if (!pending || pending.expiresAt <= Date.now()) {
    return {
      accepted: false,
      message: "期限切れ、または未登録の連携イベントです。",
    };
  }

  // URLを発行した利用者と、Webhookイベントの送信元を照合
  if (!eventUserId || eventUserId !== pending.userId) {
    return {
      accepted: false,
      message: "連携対象のユーザーが一致しません。",
    };
  }

  pendingByNonce.delete(nonce);
  pendingByUser.delete(pending.userId);

  const verified = result === "ok";

  statuses.set(pending.userId, {
    verified,
    updatedAt: Date.now(),
  });

  return {
    accepted: true,
    userId: pending.userId,
    message: verified
      ? "LINEアカウントの連携確認が完了しました。"
      : "LINEアカウントの連携確認に失敗しました。もう一度 !setup を実行してください。",
  };
}

export function unlinkAccount(userId: string): boolean {
  const pending = pendingByUser.get(userId);

  if (pending) {
    pendingByNonce.delete(pending.nonce);
    pendingByUser.delete(userId);
  }

  return statuses.delete(userId);
}